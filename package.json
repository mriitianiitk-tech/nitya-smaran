{
    "name": "nitya-smaran",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "cf:dev": "npm run build && wrangler pages dev dist",
        "cf:deploy": "npm run build && wrangler pages deploy dist --project-name=nitya-smaran",
        "db:local": "wrangler d1 execute nitya-smaran-db --local --file=./schema.sql",
        "db:remote": "wrangler d1 execute nitya-smaran-db --remote --file=./schema.sql"
    },
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^4.3.1",
        "vite": "^5.4.2",
        "wrangler": "^3.78.0"
    }
}